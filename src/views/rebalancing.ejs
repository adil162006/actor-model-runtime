<section class="page-head" data-live-rebalancing data-refresh-ms="3000">
  <div>
    <div class="section-kicker">
      OWNERSHIP MIGRATION <span>AUTOMATIC · LIVE</span>
    </div>
    <h1>Automatic balancing</h1>
    <p>
      Actors are redistributed automatically after worker joins, drains, and
      periodic health checks. Use the manual run below when you need to show a handoff immediately.
    </p>
  </div>
  <div class="live-status" aria-live="polite">
    <i class="status-dot green"></i><span>Watching live runtime</span>
    <small data-last-updated>connecting…</small>
  </div>
</section>
<section class="panel form-panel manual-action-panel">
  <div class="panel-heading">
    <div><h2>Manual rebalance</h2><small>Runs the safe drain, transfer, and resume workflow immediately.</small></div>
    <form method="post" action="/rebalancing/trigger"><button class="button primary" type="submit">Run rebalance now</button></form>
  </div>
  <p class="subtle">Requires at least <%= minimumWorkers %> live workers. “Moved 0 actors” means placement was already balanced.</p>
</section>
<div class="note-bar auto-note">
  <span class="note-symbol">A</span>
  <p>
    <b>Two-pod threshold:</b> balancing starts only when at least
    <%= minimumWorkers %> live worker pods are registered. The coordinator runs
    every <%= autoRebalanceIntervalMs / 1000 %> seconds and immediately on pod join or drain.
  </p>
</div>
<section class="panel table-panel">
  <div class="panel-heading">
    <div>
      <h2>Current distribution</h2>
      <small data-distribution-summary
        ><%= workers.length %> live worker(s) · <%= actors.length %> assigned
        actor(s)</small
      >
    </div>
  </div>
  <% if(workers.length){ %>
  <div class="distribution" data-distribution>
    <% workers.forEach(worker=>{const count=actors.filter(a=>a.workerId===worker.workerId).length; %>
    <div class="dist-row">
      <div>
        <b><%= worker.workerId %></b
        ><small
          ><%= worker.host || worker.url %> · target about <%= Math.ceil(actors.filter(a=>a.workerId).length / workers.length) %></small
        >
      </div>
      <div class="dist-bar">
        <i style="width: <%= Math.max(4,actors.length?count/actors.length*100:0) %>%"></i>
      </div>
      <strong><%= count %></strong>
    </div>
    <% }) %>
  </div>
  <% }else{ %>
  <div class="empty">
    Start at least two workers to demonstrate actor migration.
  </div>
  <% } %>
</section>
<section class="panel table-panel">
  <div class="panel-heading">
    <div>
      <h2>Rebalance and failover events</h2>
      <small>Recent coordinator events and persisted migration records</small>
    </div>
  </div>
  <% if(events.length){ %>
  <div class="event-list" data-events>
    <% events.forEach(event=>{ %>
    <div class="event-row">
      <i class="status-dot amber"></i
      ><span class="event-kind"><%= event.type %></span
      ><span><%= event.message %></span><time><%= new Date(event.createdAt).toLocaleString() %></time>
    </div>
    <% }) %>
  </div>
  <% }else{ %>
  <div class="empty">No migration events recorded.</div>
  <% } %>
</section>
<section class="panel table-panel">
  <div class="panel-heading">
    <div>
      <h2>Migration history</h2>
      <small data-migration-summary
        ><%= migrations.length %> recorded automatic transfer(s)</small
      >
    </div>
  </div>
  <% if(migrations.length){ %>
  <div class="table-wrap" data-migrations>
    <table>
      <thead>
        <tr>
          <th>ACTOR</th>
          <th>SOURCE POD</th>
          <th>DESTINATION POD</th>
          <th>GENERATION</th>
          <th>STATUS</th>
          <th>STARTED</th>
        </tr>
      </thead>
      <tbody>
        <% migrations.forEach(migration=>{ %>
        <tr>
          <td><%= migration.actorId %></td>
          <td><%= migration.sourceWorkerId || 'UNASSIGNED' %></td>
          <td><%= migration.destinationWorkerId %></td>
          <td><%= migration.fromGeneration %> → <%= migration.toGeneration %></td>
          <td><%= migration.status %><%= migration.error ? `: ${migration.error}` : '' %></td>
          <td><%= new Date(migration.startedAt).toLocaleString() %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% }else{ %>
  <div class="empty">No persisted migrations yet.</div>
  <% } %>
</section>
